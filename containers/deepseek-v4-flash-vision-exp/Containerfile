FROM vllm/vllm-openai:vision-base-8568b4bbc821

USER root
WORKDIR /opt/deepseek-v4-flash-vision-exp

COPY flashinfer-7a55473b9e3f81a1ce7c862c3b993f6ef23cab5f.patch ./
COPY apply_runtime_patches.py ./
COPY deepseek_v4_vision_trace.py ./
COPY vision_media_guard.py ./
COPY launch_vllm.py ./
COPY verify_runtime_install.py ./

ENV PYTHONPATH=/opt/deepseek-v4-flash-vision-exp
ENV VLLM_MEDIA_URL_ALLOW_REDIRECTS=0

RUN python3 ./apply_runtime_patches.py \
      --upstream-patch ./flashinfer-7a55473b9e3f81a1ce7c862c3b993f6ef23cab5f.patch \
      > ./patch-receipt.json \
    && chmod 0444 ./*.py ./*.patch ./patch-receipt.json \
    && python3 ./verify_runtime_install.py

LABEL org.opencontainers.image.base.digest="sha256:8568b4bbc821903d93a0a9c17dd80382fdc0ba78eaa128e3eb5cb71c3bf06b79" \
