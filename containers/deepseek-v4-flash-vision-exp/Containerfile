      io.dgxspark.flashinfer.patch-commit="7a55473b9e3f81a1ce7c862c3b993f6ef23cab5f" \
      io.dgxspark.flashinfer.patch-sha256="73c32044c5cddcb595782e5d6b4f6622f77ca97d9d3ffad22c9dcd8417031de4" \
      io.dgxspark.deepseek.model-repository="drowzeys/keys-DeepSeekV4Flash-Vision-EXP-ablit" \
      io.dgxspark.deepseek.model-revision="48095b3452a17f3e3ae8f77892399389c45de9e1" \
