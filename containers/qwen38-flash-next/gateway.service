[Unit]
Description=Qwen3.8 authenticated LAN gateway
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/run/qwen38-flash-next/active-nginx.conf

[Service]
Type=simple
ExecStart=/usr/bin/docker run --rm --name qwen38-flash-next-gateway --network host --read-only --tmpfs /var/cache/nginx:rw,nosuid,nodev,noexec,size=32m --tmpfs /var/run:rw,nosuid,nodev,noexec,size=1m --tmpfs /var/log/nginx:rw,nosuid,nodev,noexec,size=4m -v /run/qwen38-flash-next:/run/qwen38-flash-next:ro -v /run/secrets/qwen38-auth.conf:/run/secrets/qwen38-auth.conf:ro --entrypoint nginx sha256:35f3cbee4fb77c3efb39f2723a21ce181906139442a37de8ffc52d89641d9936 -c /run/qwen38-flash-next/active-nginx.conf -g "daemon off;"
ExecStop=/usr/bin/docker stop --time 30 qwen38-flash-next-gateway
Restart=no
TimeoutStartSec=60
TimeoutStopSec=45
