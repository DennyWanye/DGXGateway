# Trusted shell configuration; copy to cluster.env on every node.
H3_ROOT=/srv/h3
IMAGE=local/h3-sglang:20260917
HEAD_IP=CHANGE_ME_TO_REACHABLE_NODE0_IP
DIST_PORT=20000
TEST_PORT=29500
API_PORT=30010
# Keep API private; remote clients can use an SSH tunnel to node 0.
API_BIND=127.0.0.1
# tcp for initial diagnostics; rdma only after the physical fabric is configured.
NETWORK_MODE=tcp
# One cluster-wide choice: q, u-q, p, u-p. All four nodes must agree.
PROFILE=q
